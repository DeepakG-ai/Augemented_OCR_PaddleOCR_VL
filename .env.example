# Database
DATABASE_URL=postgresql://augocr:augocr@localhost:5432/augocr
REDIS_URL=redis://localhost:6379/0

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_DOCUMENTS_BUCKET=augocr-documents
MINIO_ARTIFACTS_BUCKET=augocr-artifacts
MINIO_EXPORTS_BUCKET=augocr-exports

# LLM
LLM_URL=http://host.docker.internal:8001/v1/chat/completions
LLM_MODEL=qwen3vl

# Workers
WORKER_POLL_SECONDS=1.0

# Frontend
VITE_API_BASE_URL=http://localhost:8000
