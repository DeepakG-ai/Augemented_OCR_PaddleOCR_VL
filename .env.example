# Database — Supabase (managed Postgres). The app connects over the network;
# no local Postgres runs in the pod. Use the SESSION POOLER (port 5432), NOT the
# transaction pooler (6543) — the app uses advisory locks during schema init,
# which only work in session mode. The URL must end with ?sslmode=require.
# Get this from Supabase: Project → Connect → Session pooler.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# MinIO for the manual RunPod single-pod process setup
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=replace_with_minio_access_key
MINIO_SECRET_KEY=replace_with_strong_minio_secret_key
MINIO_SECURE=false
MINIO_DOCUMENTS_BUCKET=augocr-documents
MINIO_ARTIFACTS_BUCKET=augocr-artifacts
MINIO_EXPORTS_BUCKET=augocr-exports

# Auth / bootstrap admin
SECRET_KEY=replace_with_64_hex_chars
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_strong_admin_password

# MLflow
MLFLOW_ENABLED=true
MLFLOW_TRACKING_URI=http://127.0.0.1:5000
MLFLOW_EXPERIMENT_NAME=augmented_ocr

# llama-server (all used by start.sh and supervisord.conf)
# LLM_PAGE_BATCH_SIZE must always equal LLAMA_PARALLEL
MODEL_GGUF=/workspace/models/qwen3.5/Qwen3.5-9B-UD-Q4_K_XL.gguf
MMPROJ_GGUF=/workspace/models/qwen3.5/mmproj-F16.gguf
LLAMA_BIN=/workspace/llama-server/llama-server
LLAMA_LIB_DIR=/workspace/llama-server
LLAMA_HOST=127.0.0.1
LLAMA_PORT=8056
LLAMA_N_GPU_LAYERS=99
LLAMA_CTX_SIZE=8192
LLAMA_BATCH_SIZE=4096
LLAMA_PARALLEL=1
LLAMA_IMAGE_MIN_TOKENS=1024
LLAMA_IMAGE_MAX_TOKENS=2048
# Continuous batching — pass the flag to enable, set empty to disable
# LLAMA_CONT_BATCHING=--cont-batching

# App LLM client (LLM_PAGE_BATCH_SIZE must match LLAMA_PARALLEL above)
LLM_URL=http://127.0.0.1:8056/v1/chat/completions
LLM_MODEL=qwen3vl
LLM_PAGE_BATCH_SIZE=1
LLM_TIMEOUT=300

# Workers / OCR
WORKER_POLL_SECONDS=1.0
OCR_DEVICE=cpu
OCR_WORKERS=3
# Per-engine CPU math threads. Also pins OMP/MKL/OpenBLAS so OCR_WORKERS
# concurrent engines can't each grab every core. Peak OCR threads per process
# ~= OCR_WORKERS x OCR_CPU_THREADS; keep that under the box's core count.
OCR_CPU_THREADS=4

# Optional manual RunPod paths. Leave VENV_DIR commented if your venv is at
# /workspace/app/.venv, /workspace/.venv, or /workspace/venvs/augocr.
# VENV_DIR=/workspace/app/.venv

# Public surface
# RunPod example: CORS_ALLOW_ORIGINS=https://yourpodid-8000.proxy.runpod.net
CORS_ALLOW_ORIGINS=

# Logs
PIPELINE_LOG_DIR=/workspace/logs/pipeline
LOG_LEVEL=INFO
