# ─────────────────────────────────────────────────────────────────────────────
# Database — direct PostgreSQL (AWS VM or any Postgres host)
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
# IMPORTANT: if your password contains special characters, URL-encode them:
#   @  →  %40      #  →  %23      $  →  %24      space → %20
# Example: password "P@ss#1" becomes "P%40ss%231"
# ─────────────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:<password>@<host-ip>:5432/augocr

# ─────────────────────────────────────────────────────────────────────────────
# MinIO — object storage (runs locally in the pod)
# ─────────────────────────────────────────────────────────────────────────────
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=replace_with_minio_access_key
MINIO_SECRET_KEY=replace_with_strong_minio_secret_key
MINIO_SECURE=false
MINIO_DOCUMENTS_BUCKET=augocr-documents
MINIO_ARTIFACTS_BUCKET=augocr-artifacts
MINIO_EXPORTS_BUCKET=augocr-exports

# ─────────────────────────────────────────────────────────────────────────────
# Auth — JWT secret + bootstrap admin account
# Generate SECRET_KEY with: openssl rand -hex 32
# ─────────────────────────────────────────────────────────────────────────────
SECRET_KEY=replace_with_64_hex_chars
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_strong_admin_password

# ─────────────────────────────────────────────────────────────────────────────
# MLflow — experiment tracking
# ─────────────────────────────────────────────────────────────────────────────
MLFLOW_ENABLED=true
MLFLOW_TRACKING_URI=http://127.0.0.1:5000
MLFLOW_EXPERIMENT_NAME=augmented_ocr

# ─────────────────────────────────────────────────────────────────────────────
# llama-server — vision LLM (Qwen3-VL via llama.cpp)
#
# LLAMA_PARALLEL  = number of concurrent KV-cache slots (= GPU parallel streams)
#                   RTX 4060 8GB  → 2    RTX 5090 32GB → 4
#
# LLAMA_CTX_SIZE  = total context window across all slots (-c flag).
#                   Leave it out (comment it) — start.sh auto-sets it to
#                   LLAMA_PARALLEL × LLAMA_CTX_PER_SLOT (default 8192/slot).
#                   Only set it manually if you know what you're doing.
#
# LLAMA_CTX_PER_SLOT = context tokens per slot (default 8192). Controls how
#                   much prompt+image+output space each parallel stream gets.
#
# LLAMA_CONT_BATCHING = pass --cont-batching to enable continuous batching
#                   (recommended for parallel > 1). Set empty to disable.
# ─────────────────────────────────────────────────────────────────────────────
MODEL_GGUF=/workspace/models/qwen3.5/Qwen3.5-9B-UD-Q4_K_XL.gguf
MMPROJ_GGUF=/workspace/models/qwen3.5/mmproj-F16.gguf
LLAMA_BIN=/workspace/llama-server/llama-server
LLAMA_LIB_DIR=/workspace/llama-server
LLAMA_HOST=127.0.0.1
LLAMA_PORT=8056
LLAMA_N_GPU_LAYERS=99
LLAMA_PARALLEL=1
LLAMA_CTX_PER_SLOT=8192
# LLAMA_CTX_SIZE=           ← leave commented; start.sh calculates it
LLAMA_BATCH_SIZE=4096
LLAMA_IMAGE_MIN_TOKENS=1024
LLAMA_IMAGE_MAX_TOKENS=2048
LLAMA_CONT_BATCHING=--cont-batching

# ─────────────────────────────────────────────────────────────────────────────
# App LLM client
# LLM_PAGE_BATCH_SIZE: pages sent concurrently per document.
#   start.sh defaults this to LLAMA_PARALLEL automatically.
#   Set to 1 if running multiple llm workers (cross-user cont-batching).
# ─────────────────────────────────────────────────────────────────────────────
LLM_URL=http://127.0.0.1:8056/v1/chat/completions
LLM_MODEL=qwen3vl
# LLM_PAGE_BATCH_SIZE=1     ← defaults to LLAMA_PARALLEL; override if needed
LLM_TIMEOUT=300

# ─────────────────────────────────────────────────────────────────────────────
# Workers / OCR
# Peak OCR threads ≈ OCR_WORKERS × OCR_CPU_THREADS — keep under core count.
# ─────────────────────────────────────────────────────────────────────────────
WORKER_POLL_SECONDS=1.0
OCR_DEVICE=cpu
OCR_WORKERS=3
OCR_CPU_THREADS=4

# ─────────────────────────────────────────────────────────────────────────────
# Paths (optional overrides)
# ─────────────────────────────────────────────────────────────────────────────
# VENV_DIR=/workspace/app/.venv    ← only needed if venv is in a custom location

# ─────────────────────────────────────────────────────────────────────────────
# Public surface
# Set to your RunPod proxy URL or load-balancer origin, e.g.:
#   CORS_ALLOW_ORIGINS=https://yourpodid-8000.proxy.runpod.net
# ─────────────────────────────────────────────────────────────────────────────
CORS_ALLOW_ORIGINS=

# ─────────────────────────────────────────────────────────────────────────────
# Logging
# ─────────────────────────────────────────────────────────────────────────────
PIPELINE_LOG_DIR=/workspace/logs/pipeline
LOG_LEVEL=INFO
