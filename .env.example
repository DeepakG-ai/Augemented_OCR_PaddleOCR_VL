# Database
DATABASE_URL=postgresql+asyncpg://ocr:ocr@postgres:5432/ocrdb
SYNC_DATABASE_URL=postgresql://ocr:ocr@postgres:5432/ocrdb

# Redis
REDIS_URL=redis://redis:6379/0

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=ocr-documents
MINIO_SECURE=false

# vLLM (runs locally on WSL2, reached via host.docker.internal)
VLLM_SERVER_URL=http://host.docker.internal:8001
VLLM_MODEL=PaddlePaddle/PaddleOCR-VL-1.5
VLLM_TIMEOUT=60

# Celery
CELERY_CONCURRENCY=4

# Frontend
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000
