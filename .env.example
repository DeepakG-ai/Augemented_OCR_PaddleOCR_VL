# Copy this file to .env before starting the local Docker stack.
# Compose overrides service-to-service hostnames inside containers.

# Local ports
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MLFLOW_PORT=5000

# Database
POSTGRES_DB=augocr
POSTGRES_USER=augocr
POSTGRES_PASSWORD=augocr_local_password
DATABASE_URL=postgresql://augocr:augocr_local_password@localhost:5432/augocr
DB_POOL_MIN_API=2
DB_POOL_MAX_API=15
DB_POOL_MIN_WORKER=1
DB_POOL_MAX_WORKER=3

# Redis cache
REDIS_URL=redis://localhost:6379/0
CACHE_ENABLED=true

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=augocr
MINIO_SECRET_KEY=augocr_local_secret
MINIO_SECURE=false
MINIO_DOCUMENTS_BUCKET=augocr-documents
MINIO_ARTIFACTS_BUCKET=augocr-artifacts
MINIO_EXPORTS_BUCKET=augocr-exports

# Auth/bootstrap. Replace these before exposing the service beyond localhost.
SECRET_KEY=local-docker-only-change-before-sharing
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin12345

# llama-server runs directly on the host at port 8056. Compose supplies
# host.docker.internal to containers through DOCKER_LLM_URL.
LLM_URL=http://localhost:8056/v1/chat/completions
DOCKER_LLM_URL=http://host.docker.internal:8056/v1/chat/completions
LLM_MODEL=qwen3vl
LLM_PAGE_BATCH_SIZE=1
LLM_TIMEOUT=300

# Workers/OCR
WORKER_POLL_SECONDS=1.0
OCR_DEVICE=cpu
OCR_WORKERS=1
PADDLEOCR_PREWARM=1

# MLflow and public API
MLFLOW_ENABLED=true
MLFLOW_TRACKING_URI=http://localhost:5000
CORS_ALLOW_ORIGINS=http://localhost:8055,http://127.0.0.1:8055
FRAME_ANCESTORS=

# Logs
PIPELINE_LOG_DIR=logs/pipeline
LOG_LEVEL=INFO
