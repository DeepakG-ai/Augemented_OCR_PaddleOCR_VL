# Database
POSTGRES_DB=augocr
POSTGRES_USER=augocr
POSTGRES_PASSWORD=replace_with_strong_postgres_password
DATABASE_URL=postgresql://augocr:replace_with_strong_postgres_password@127.0.0.1:5432/augocr

# Connection pool sizing (per process role). API is one process serving bursty
# reads + SSE; each worker handles one job at a time. Keep the total
# (1 API * MAX_API + N workers * MAX_WORKER) well under Postgres max_connections.
DB_POOL_MIN_API=2
DB_POOL_MAX_API=15
DB_POOL_MIN_WORKER=1
DB_POOL_MAX_WORKER=3

# Redis read cache (optional). Runs in-pod on localhost (see [program:redis] in
# supervisord.conf). If unreachable or CACHE_ENABLED=false, the app falls back
# to a no-op cache and reads straight from Postgres — always safe, just slower.
REDIS_URL=redis://127.0.0.1:6379/0
CACHE_ENABLED=true
# CACHE_PREFIX=augocr
# TTLs in seconds (defaults shown):
# CACHE_TTL_AUTH=60
# CACHE_TTL_VENDOR=600
# CACHE_TTL_TEMPLATE=600
# CACHE_TTL_MAPPING=600
# CACHE_TTL_ALIAS=300
# CACHE_TTL_DASHBOARD=30

# MinIO for the manual RunPod single-pod process setup
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=replace_with_minio_access_key
MINIO_SECRET_KEY=replace_with_strong_minio_secret_key
MINIO_SECURE=false
MINIO_DOCUMENTS_BUCKET=augocr-documents
MINIO_ARTIFACTS_BUCKET=augocr-artifacts
MINIO_EXPORTS_BUCKET=augocr-exports

# Auth / bootstrap admin
SECRET_KEY=replace_with_64_hex_chars
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_strong_admin_password

# MLflow
MLFLOW_ENABLED=true
MLFLOW_TRACKING_URI=http://127.0.0.1:5000
MLFLOW_EXPERIMENT_NAME=augmented_ocr

# llama-server (all used by start.sh and supervisord.conf)
# LLM_PAGE_BATCH_SIZE must always equal LLAMA_PARALLEL
MODEL_GGUF=/workspace/models/qwen3.5/Qwen3.5-9B-UD-Q4_K_XL.gguf
MMPROJ_GGUF=/workspace/models/qwen3.5/mmproj-F16.gguf
LLAMA_BIN=/workspace/llama-server/llama-server
LLAMA_LIB_DIR=/workspace/llama-server
LLAMA_HOST=127.0.0.1
LLAMA_PORT=8056
LLAMA_N_GPU_LAYERS=99
LLAMA_CTX_SIZE=8192
LLAMA_BATCH_SIZE=4096
LLAMA_PARALLEL=1
LLAMA_IMAGE_MIN_TOKENS=1024
LLAMA_IMAGE_MAX_TOKENS=2048
# Continuous batching — pass the flag to enable, set empty to disable
# LLAMA_CONT_BATCHING=--cont-batching

# App LLM client (LLM_PAGE_BATCH_SIZE must match LLAMA_PARALLEL above)
LLM_URL=http://127.0.0.1:8056/v1/chat/completions
LLM_MODEL=qwen3vl
LLM_PAGE_BATCH_SIZE=1
LLM_TIMEOUT=300

# Workers / OCR
WORKER_POLL_SECONDS=1.0
OCR_DEVICE=cpu
# Single OCR engine/process — avoids concurrent PaddleOCR init oversubscribing
# the CPU. Keep in sync with the number of ocr-N workers in supervisord.conf.
OCR_WORKERS=1

# Optional manual RunPod paths. Leave VENV_DIR commented if your venv is at
# /workspace/app/.venv, /workspace/.venv, or /workspace/venvs/augocr.
# VENV_DIR=/workspace/app/.venv

# Postgres data dir — must be on local filesystem (not /workspace network volume)
# so that PostgreSQL's strict permission checks pass.
PGDATA=/var/lib/postgresql/data

# Automated backup: pg_dump written here every PG_BACKUP_INTERVAL seconds.
# /workspace persists across pod migrations so backups survive container recreation.
PG_BACKUP_DIR=/workspace/backups/postgres
PG_BACKUP_INTERVAL=300

# Public surface
# RunPod example: CORS_ALLOW_ORIGINS=https://yourpodid-8000.proxy.runpod.net
CORS_ALLOW_ORIGINS=

# Iframe embedding — comma-separated origins allowed to embed this app in an
# <iframe>. Leave empty (default) to send X-Frame-Options: DENY. When set,
# sends CSP frame-ancestors 'self' <origins> instead.
# Example: FRAME_ANCESTORS=https://portal.example.com,http://localhost:8080
FRAME_ANCESTORS=

# Logs
PIPELINE_LOG_DIR=/workspace/logs/pipeline
LOG_LEVEL=INFO
